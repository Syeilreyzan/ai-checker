# ============================================================================
# STAGE 1: DETECTION ENGINE (Free Screening: Sapling / HuggingFace / Built-in)
# ============================================================================
# Options: auto | sapling | huggingface | openai | gemini | forensic
DETECTION_ENGINE=auto

# Sapling Free AI Detector API Key (https://sapling.ai/ai-content-detector)
SAPLING_API_KEY=

# Hugging Face Free Inference Token for RoBERTa AI Detector (https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=

# ============================================================================
# STAGE 2: TARGETED HUMANIZATION ENGINE (ToHuman 2,500 Free Words / LLM)
# ============================================================================
# Options: auto | tohuman | openai | gemini | anthropic
LLM_PROVIDER=openai

# ToHuman API Key — 2,500 free words/month, 60 req/min (no credit card needed)
TOHUMAN_API_KEY=
TOHUMAN_API_URL=https://api.tohuman.ai/v1/humanize

# OpenAI / Gemini / Anthropic Keys (for LLM-based detection & targeted rewriting)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
